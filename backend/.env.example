PORT=5679

# Same MongoDB Cloud cluster as mkt-ai (database in the URI path, usually reform-ai).
# Collections are prefixed with drama_ (override with DRAMA_MONGO_COLLECTION_PREFIX).
MONGODB_AI_URI=mongodb+srv://USER:PASS@HOST/reform-ai?retryWrites=true&w=majority

# Optional. Defaults to ../data/static from compiled source location.
# Used when S3 is not configured (local dev).
# STORAGE_PATH=../data/static

# Shared mkt-ai media CDN. When bucket + keys are set, generated files
# are stored as drama/{images|videos|merged|uploads}/… and served via CloudFront.
# Local /tmp is only used as FFmpeg scratch.
# AWS_S3_BUCKET=ai-marketing-bucket
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-east-1
# USE_CLOUDFRONT_MEDIA_URLS=true
# CLOUDFRONT_DOMAIN=cdn-staging.i-gen.ai
# DRAMA_SCRATCH_PATH=/tmp/drama

# Optional. When set, all /api/v1/* requests must send X-Drama-Service-Key.
# Leave empty for local Nuxt development.
# DRAMA_SERVICE_KEY=

# Platform-seeded AI configs (used when the DB has no active config of that type).
# Reuse the same keys as mkt-ai / Helm (GOOGLE_GEMINI_API_KEY, BYTEPLUS_ARK_API_KEY, MINIMAX_API_KEY).
# DRAMA_TEXT_PROVIDER=gemini
# DRAMA_TEXT_BASE_URL=https://generativelanguage.googleapis.com
# DRAMA_TEXT_API_KEY=
# DRAMA_TEXT_MODEL=gemini-2.5-flash
# DRAMA_IMAGE_PROVIDER=gemini
# DRAMA_IMAGE_BASE_URL=https://generativelanguage.googleapis.com
# DRAMA_IMAGE_API_KEY=
# DRAMA_IMAGE_MODEL=gemini-3.1-flash-image
# DRAMA_VIDEO_PROVIDER=gemini
# DRAMA_VIDEO_BASE_URL=https://generativelanguage.googleapis.com
# DRAMA_VIDEO_API_KEY=
# DRAMA_VIDEO_MODEL=gemini-omni-flash-preview
# MiniMax H3 video reuses the TTS key. Same host as speech: https://api.minimax.io
# MINIMAX_API_KEY=
# MINIMAX_TTS_BASE_URL=https://api.minimax.io
# MINIMAX_VIDEO_BASE_URL=https://api.minimax.io
# Set DRAMA_VIDEO_PROVIDER=minimax (and MiniMax-H3) to make H3 the default video model.
# PUBLIC_BASE_URL is required so vendors can fetch uploaded reference media
# (local /static paths are resolved as PUBLIC_BASE_URL + path).
# PUBLIC_BASE_URL=https://your-domain.com

# Optional. 关闭文本模型思考(thinking)模式,默认 true。
# 对 new-api 类中转站在请求体注入关思考参数,规避中转站强制回传
# reasoning_content 导致的 400;官方 OpenAI/Gemini 端点自动跳过。
# AI_DISABLE_THINKING=false
# 可选:自定义注入的 OpenAI 风格参数(JSON),适配不同中转站
# AI_THINKING_OFF_PATCH={"thinking":{"type":"disabled"},"enable_thinking":false}
